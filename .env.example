# Create a "Chrome Extension" OAuth client in Google Cloud Console and enable
# Google Drive API. The client must be bound to the unpacked/store extension ID.
WXT_GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Optional for unpacked builds on multiple machines. Use the same public key on
# every device so Chromium derives the same extension ID. Never commit the
# corresponding private PEM key.
WXT_EXTENSION_PUBLIC_KEY=BASE64_ENCODED_DER_PUBLIC_KEY
